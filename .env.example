# === REQUIRED FOR PRODUCTION (add in Vercel → Settings → Environment Variables) ===

# AI Chatbot (get free key at https://console.groq.com)
GROQ_API_KEY=

# Contact form — where messages are delivered
CONTACT_EMAIL=sjnigam10@gmail.com

# Your live site URL (required for contact form)
NEXT_PUBLIC_SITE_URL=https://portfolio-saket-tan.vercel.app

# === EMAIL — pick ONE (Resend recommended) ===

# Option A: Resend (best for production) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Option B: Web3Forms (free, easy) — https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Option C: FormSubmit (no key, but needs one-time email activation)
# Used automatically if neither Resend nor Web3Forms is set

# === OPTIONAL ===
OPENAI_API_KEY=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_COLLECTION=
